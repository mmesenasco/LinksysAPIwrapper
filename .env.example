# Copy to .env (or set these as stack env vars in Portainer). All optional.

# --- Deployment (compose/Swarm) ---
IMAGE_TAG=latest
GUI_PORT=8091
OVERLAY_NETWORK=homelab        # name of your existing external overlay network
DEPLOY_NODE=rpi1               # swarm node hostname to pin the service to

# --- Router ---
ROUTER_URL=http://192.168.1.1
POLL_INTERVAL=30
ALLOW_WRITES=false             # true = enable DHCP reservation + node reboot endpoints
# ROUTER_PASSWORD is provided via the docker secret `router_password`,
# or ROUTER_PASSWORD / ROUTER_PASSWORD_FILE when running without Swarm.

# --- Home Assistant (MQTT discovery). Leave MQTT_HOST empty to disable. ---
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
